# Nebula Supermarket Ops Agent — Environment Variables
# Copy this file, rename the copy to .env, and fill in your real values.
# NEVER commit .env to Git — it is in .gitignore.

# Your Supabase PostgreSQL connection string.
# Find it at: Supabase Dashboard → your project → Settings → Database
# → scroll to "Connection string" → select "URI" tab → copy
DATABASE_URL=
